# Flask application settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
APP_NAME=Conecta
SECRET_KEY=
JWT_SECRET_KEY=
APP_URL=http://localhost:5000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=conecta
DB_USERNAME=root
DB_PASSWORD=
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:@127.0.0.1:3306/conecta
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Logging
LOG_LEVEL=DEBUG

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=False

# Cache / Queue
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail
MAIL_SERVER=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=hello@example.com

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
